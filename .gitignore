/target
/dist
/node_modules
**/*.rs.bk
.DS_Store
.vscode/
.idea/

# Local SQLite databases and runtime data. These never belong in the repo;
# the container mounts /data as a volume.
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# VAPID and any local keypairs. Keep real secrets outside the repo on the
# internal deployment; the public repo never sees them.
/keys/
*.pem
*.p12
*.pfx

# mdBook output (Phase 14)
/book
docs/book

# Playwright e2e workspace artifacts. Screenshot baselines are committed
# ONLY as the CI runner's -linux renders (fonts differ per platform);
# local-platform renders stay local.
tests/e2e/node_modules/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/smoke.spec.ts-snapshots/*-win32.png
tests/e2e/smoke.spec.ts-snapshots/*-darwin.png
